.jupyter_cache/
_build/
venv/
.venv/
.*.sw?
*.drawio.bkp
*.res.txt

# Build-time copies of hardware renders (generated by make copy-assets)
content/img/mainboard-*.png
content/img/mk2wifi-*.png
content/img/indicator-*.png
__pycache__/

# Host CA certificates copied by the devcontainer initializeCommand; the folder
# itself is kept (.gitkeep) so that the image also builds without it
.devcontainer/certs/*
!.devcontainer/certs/.gitkeep
